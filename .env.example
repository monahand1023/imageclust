# Set to "true" to use static AWS credentials from environment variables.
# When not set or "false", the default AWS credential chain is used (IAM roles, etc.).
DEV_MODE=false

# AWS credentials (only required when DEV_MODE=true)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region used for Rekognition
AWS_REGION=us-east-1
